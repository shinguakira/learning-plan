  "paths": {
    "/api/certificate": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "user",
                  "name",
                  "issuer",
                  "dateEarned"
                ],
                "properties": {
                  "user": {
                    "type": "string",
                    "enum": [
                      "Sanjar",
                      "Akira",
                      "Mike",
                      "John"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "issuer": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "dateEarned": {
                    "type": "string",
                    "format": "date"
                  },
                  "credentialUrl": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https?://"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
