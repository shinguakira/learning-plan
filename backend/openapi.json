{
  "openapi": "3.1.0",
  "info": {
    "title": "learning-plan API",
    "description": "Tasks, profiles, skills, strengths, certificates and job history.",
    "version": "0.0.0"
  },
  "components": {
    "schemas": {
      "error": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "mockUser": {
        "type": "string",
        "enum": [
          "Sanjar",
          "Akira",
          "Mike",
          "John"
        ]
      },
      "skillLevel": {
        "type": "string",
        "enum": [
          "beginner",
          "intermediate",
          "advanced",
          "expert"
        ]
      },
      "employmentType": {
        "type": "string",
        "enum": [
          "full-time",
          "contract",
          "part-time",
          "internship"
        ]
      },
      "taskCategory": {
        "type": "string",
        "enum": [
          "Frontend",
          "Backend",
          "Infra / Cloud",
          "Database",
          "CS Fundamentals",
          "Certification"
        ]
      },
      "taskStatus": {
        "type": "string",
        "enum": [
          "todo",
          "doing",
          "done"
        ]
      },
      "taskPriority": {
        "type": "string",
        "enum": [
          "low",
          "mid",
          "high"
        ]
      },
      "skill": {
        "type": "object",
        "required": [
          "id",
          "name",
          "level",
          "yearsOfExperience",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "$ref": "#/components/schemas/skillLevel"
          },
          "yearsOfExperience": {
            "type": "integer",
            "minimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "strength": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "job": {
        "type": "object",
        "required": [
          "id",
          "company",
          "title",
          "employmentType",
          "startDate",
          "endDate",
          "summary",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "company": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "employmentType": {
            "$ref": "#/components/schemas/employmentType"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "summary": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "certificate": {
        "type": "object",
        "required": [
          "id",
          "name",
          "issuer",
          "dateEarned",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "issuer": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "dateEarned": {
            "type": "string",
            "format": "date"
          },
          "credentialUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "task": {
        "type": "object",
        "required": [
          "title",
          "category",
          "status",
          "priority",
          "estimatedHours",
          "note",
          "offsetStart",
          "span"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/taskCategory"
          },
          "status": {
            "$ref": "#/components/schemas/taskStatus"
          },
          "priority": {
            "$ref": "#/components/schemas/taskPriority"
          },
          "estimatedHours": {
            "type": "number"
          },
          "note": {
            "type": "string"
          },
          "offsetStart": {
            "type": "integer"
          },
          "span": {
            "type": "integer"
          }
        }
      },
      "technology": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "profile": {
        "type": "object",
        "required": [
          "skills",
          "strengths",
          "jobs",
          "certificates"
        ],
        "properties": {
          "skills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/skill"
            }
          },
          "strengths": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/strength"
            }
          },
          "jobs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/job"
            }
          },
          "certificates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/certificate"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/certificate": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "user",
                  "name",
                  "issuer",
                  "dateEarned"
                ],
                "properties": {
                  "user": {
                    "$ref": "#/components/schemas/mockUser"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "issuer": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "dateEarned": {
                    "type": "string",
                    "format": "date"
                  },
                  "credentialUrl": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https?://"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/certificate"
                }
              }
            }
          },
          "409": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
