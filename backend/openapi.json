            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "issuer",
                  "dateEarned"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "issuer": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "dateEarned": {
                    "type": "string",
                    "format": "date"
                  },
                  "credentialUrl": {
                    "type": "string",
