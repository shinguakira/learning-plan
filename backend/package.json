{
  "name": "learning-plan-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "format": "oxfmt --write .",
    "format-check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint-fix": "oxlint . --fix",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "db-studio": "prisma studio",
    "db-generate": "prisma generate",
    "openapi": "tsx scripts/generateOpenapi.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pdfkit": "^0.17.7",
    "oxfmt": "0.76.0",
    "oxlint": "^1.91.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.9.3",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.5",
    "pdfkit": "^0.20.2"
  }
}
