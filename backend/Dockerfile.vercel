# Production only. Local development is still `npm run dev` with tsx - nothing
# here is needed to work on the backend, and Docker is not a prerequisite.
#
# Vercel builds this image and runs it as a Function. See doc/deployment.md.

FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production

# Vercel routes to port 80 unless PORT says otherwise. Setting it here rather
# than changing the code's fallback keeps `npm run dev` on 3001 locally.
ENV PORT=80

COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist

USER node
CMD ["node", "dist/index.js"]
