// Nothing imports the generated client yet: this is the schema only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The people the header can switch between, today the four in MOCK_USERS.
model User {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  skills    Skill[]
  strengths Strength[]

  @@map("users")
}

enum SkillLevel {
  beginner
  intermediate
  advanced
  expert

  @@map("skill_level")
}

model Skill {
  id                String     @id @default(uuid())
  userId            String     @map("user_id")
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  level             SkillLevel
  yearsOfExperience Int        @map("years_of_experience")
  createdAt         DateTime   @default(now()) @map("created_at")

  @@unique([userId, name])
  @@map("skills")
}

model Strength {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([userId, name])
  @@map("strengths")
}

/// The technologies a skill can name, today the list in SkillForm's SKILL_OPTIONS.
/// "Other" is not one of them - it is the form's escape hatch for free text.
model Technology {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("technologies")
}
