VITE_APP_TITLE=Learning Plan

# Chat endpoint. Left blank, the chat page reports that it is unconfigured.
# Any provider or local runtime that speaks the /chat/completions shape works -
# set the URL and model to whatever you want to talk to.
VITE_CHAT_API_KEY=
VITE_CHAT_API_URL=https://api.anthropic.com/v1/chat/completions
VITE_CHAT_MODEL=claude-sonnet-5

# The profile page's backend (see ../backend). Run it with npm --prefix
# backend run dev; it listens on 3001 by default.
VITE_SKILLS_API_URL=http://localhost:3001/api/skills
